{
  "name": "lead-management-crm",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client1",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace client1\" \"npm run dev --workspace server\"",
    "dev:client": "npm run dev --workspace client1",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client1",
    "start:client": "npm run preview --workspace client1",
    "start:server": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
